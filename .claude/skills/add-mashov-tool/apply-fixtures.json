{
  "notes": "Conformance fixtures for scripts/skill-conformance.test.ts. Synthetic values only, never real credentials or school data. The `(.data|length)==0` stub (the agent-list capture's jq) answers agent_groups; the `$3/mashov/mcp` and `$3/mashov/health` stubs answer the two URL captures built from `setup-cli.js endpoint`. The Mashov login is entered by the operator on the host (an nc:operator step), never through a prompt. The vault, scoping and registration wires run against the stubbed exec and capture nothing.",
  "scenarios": [
    {
      "name": "pick-one",
      "inputs": {
        "mashov_agents": "ag-11111111-1111-1111-1111-111111111111"
      },
      "exec": [
        {
          "match": "(.data|length)==0",
          "stdout": "ag-11111111-1111-1111-1111-111111111111 (Family), ag-22222222-2222-2222-2222-222222222222 (Work)"
        },
        {
          "match": "$3/mashov/mcp",
          "stdout": "http://host.docker.internal:8787/mashov/mcp"
        },
        {
          "match": "$3/mashov/health",
          "stdout": "http://host.docker.internal:8787/mashov/health"
        }
      ]
    },
    {
      "name": "all-agents-tls",
      "inputs": {
        "mashov_agents": "all"
      },
      "exec": [
        {
          "match": "(.data|length)==0",
          "stdout": "ag-11111111-1111-1111-1111-111111111111 (Family)"
        },
        {
          "match": "$3/mashov/mcp",
          "stdout": "https://host.docker.internal:8787/mashov/mcp"
        },
        {
          "match": "$3/mashov/health",
          "stdout": "https://host.docker.internal:8787/mashov/health"
        }
      ]
    },
    {
      "name": "none",
      "inputs": {
        "mashov_agents": "none"
      },
      "exec": [
        {
          "match": "(.data|length)==0",
          "stdout": "ag-11111111-1111-1111-1111-111111111111 (Family)"
        },
        {
          "match": "$3/mashov/mcp",
          "stdout": "http://host.docker.internal:8787/mashov/mcp"
        },
        {
          "match": "$3/mashov/health",
          "stdout": "http://host.docker.internal:8787/mashov/health"
        }
      ]
    }
  ]
}
