diff --git a/dist/ui/pages/agent-messages.js b/dist/ui/pages/agent-messages.js
new file mode 100644
index 0000000000000000000000000000000000000000..4aec3cf4fb4b7c844672caf65e8d30908f9cd3be
--- /dev/null
+++ b/dist/ui/pages/agent-messages.js
@@ -0,0 +1,95 @@
+import { layout } from '../layout.js';
+export function agentMessagesPage() {
+    return layout('Agent Messages', '/dashboard/agent-messages', `
+    <h2 class="page-title">Agent Messages</h2>
+    <div id="filters" style="display:flex;gap:12px;align-items:center;margin-bottom:16px;font-size:13px;color:#888">
+      <label>Agent <select id="f-agent"><option value="">All</option></select></label>
+      <label>Conversation <select id="f-pair"><option value="">All</option></select></label>
+      <input id="f-text" type="search" placeholder="Search text..." style="padding:4px 8px;background:#1a1a1a;color:#e0e0e0;border:1px solid #2a2a2a;border-radius:4px">
+      <span id="count"></span>
+    </div>
+    <div id="content"><div class="loading">Loading...</div></div>
+    <style>
+      #filters select { background:#1a1a1a;color:#e0e0e0;border:1px solid #2a2a2a;border-radius:4px;padding:4px 6px; }
+      .a2a-text { white-space:pre-wrap;word-break:break-word;font-size:12px;max-width:720px; }
+      .a2a-text details summary { cursor:pointer;color:#7eb8da; }
+      .a2a-route { white-space:nowrap;font-size:12px; }
+      .a2a-route .arrow { color:#666;margin:0 4px; }
+      .a2a-sess { font-size:11px;color:#666; }
+    </style>
+    <script>
+    (() => {
+      let all = [];
+      const PREVIEW = 400;
+      const pairKey = (m) => [m.fromAgentGroupId, m.toAgentGroupId].sort().join('|');
+      const pairLabel = (m) => [m.fromAgentGroupName, m.toAgentGroupName].sort().join(' \\u2194 ');
+      const statusColor = (s) => s === 'completed' ? 'green' : s === 'failed' ? 'red' : s === 'pending' ? 'yellow' : 'gray';
+      const sessLink = (ag, sess) => '<a class="a2a-sess" href="/dashboard/messages?agentGroupId=' + encodeURIComponent(ag) + '&sessionId=' + encodeURIComponent(sess) + '">' + esc(sess) + '</a>';
+
+      function fillSelect(id, entries) {
+        const sel = document.getElementById(id);
+        const cur = sel.value;
+        sel.innerHTML = '<option value="">All</option>' + entries.map(([v, l]) => '<option value="' + esc(v) + '">' + esc(l) + '</option>').join('');
+        sel.value = entries.some(([v]) => v === cur) ? cur : '';
+      }
+
+      function render() {
+        const agent = document.getElementById('f-agent').value;
+        const pair = document.getElementById('f-pair').value;
+        const q = document.getElementById('f-text').value.trim().toLowerCase();
+        const rows = all.filter((m) =>
+          (!agent || m.fromAgentGroupId === agent || m.toAgentGroupId === agent) &&
+          (!pair || pairKey(m) === pair) &&
+          (!q || (m.text || '').toLowerCase().includes(q)));
+        document.getElementById('count').textContent = rows.length + ' of ' + all.length + ' messages';
+        if (rows.length === 0) {
+          document.getElementById('content').innerHTML = '<div class="loading">No agent-to-agent messages</div>';
+          return;
+        }
+        let html = '<table><tr><th>Time</th><th>From \\u2192 To</th><th>Status</th><th>Message</th></tr>';
+        for (const m of rows) {
+          const text = m.text || '';
+          const body = text.length > PREVIEW
+            ? '<details><summary>' + esc(text.slice(0, PREVIEW)) + '\\u2026</summary>' + esc(text.slice(PREVIEW)) + '</details>'
+            : esc(text);
+          const att = m.attachments ? ' ' + badge(m.attachments + ' file' + (m.attachments > 1 ? 's' : ''), 'purple') : '';
+          html += '<tr>' +
+            '<td style="white-space:nowrap;font-size:12px;color:#888" title="' + esc(m.timestamp) + '">' + esc(new Date(m.timestamp).toLocaleString()) + '<br>' + timeAgo(m.timestamp) + '</td>' +
+            '<td class="a2a-route">' + badge(m.fromAgentGroupName || '?', 'blue') + '<span class="arrow">\\u2192</span>' + badge(m.toAgentGroupName || '?', 'green') +
+              '<br>' + sessLink(m.fromAgentGroupId, m.fromSessionId) + '<br>' + sessLink(m.toAgentGroupId, m.toSessionId) + '</td>' +
+            '<td>' + badge(m.status || '-', statusColor(m.status)) + '</td>' +
+            '<td class="a2a-text">' + body + att + '</td>' +
+            '</tr>';
+        }
+        html += '</table>';
+        document.getElementById('content').innerHTML = html;
+      }
+
+      async function load() {
+        try {
+          all = await api('/api/agent-messages');
+        } catch (e) {
+          document.getElementById('content').innerHTML = '<div class="loading">Error: ' + esc(e.message) + '</div>';
+          return;
+        }
+        const agents = new Map();
+        const pairs = new Map();
+        for (const m of all) {
+          agents.set(m.fromAgentGroupId, m.fromAgentGroupName);
+          agents.set(m.toAgentGroupId, m.toAgentGroupName);
+          pairs.set(pairKey(m), pairLabel(m));
+        }
+        const byLabel = (a, b) => String(a[1]).localeCompare(String(b[1]));
+        fillSelect('f-agent', [...agents].sort(byLabel));
+        fillSelect('f-pair', [...pairs].sort(byLabel));
+        render();
+      }
+
+      for (const id of ['f-agent', 'f-pair']) document.getElementById(id).addEventListener('change', render);
+      document.getElementById('f-text').addEventListener('input', render);
+      load();
+      setInterval(load, 60000);
+    })();
+    </script>
+  `);
+}
